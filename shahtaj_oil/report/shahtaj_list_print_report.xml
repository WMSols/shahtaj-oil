<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_shahtaj_list_print" model="report.paperformat">
        <field name="name">Shahtaj List Print</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_shahtaj_list_print" model="ir.actions.report">
        <field name="name">List Print</field>
        <field name="model">shahtaj.list.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">shahtaj_oil.report_shahtaj_list_print</field>
        <field name="report_file">shahtaj_oil.report_shahtaj_list_print</field>
        <field name="print_report_name">object.title or 'List'</field>
        <field name="paperformat_id" ref="paperformat_shahtaj_list_print"/>
    </record>

    <template id="report_shahtaj_list_print">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-esc="doc.title"/>
                        <t t-if="doc.filter_lines()">
                            <p t-foreach="doc.filter_lines()" t-as="line" class="mb-0" t-esc="line"/>
                        </t>
                        <p t-else="" class="text-muted mb-0">No filters</p>
                        <t t-if="doc.summary_lines()">
                            <div class="mt-2">
                                <p t-foreach="doc.summary_lines()" t-as="line" class="mb-0 fw-bold" t-esc="line"/>
                            </div>
                        </t>
                        <p class="mt-3 mb-1 fw-bold">Total rows: <t t-esc="len(doc.row_list())"/></p>
                        <table class="table table-sm table-bordered" style="font-size: 9px;">
                            <thead>
                                <tr>
                                    <th>Sr</th>
                                    <th t-foreach="doc.column_list()" t-as="col" t-esc="col"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.row_list()" t-as="row">
                                    <td t-esc="row_index + 1"/>
                                    <td t-foreach="row" t-as="cell" t-esc="cell"/>
                                </tr>
                            </tbody>
                        </table>
                        <p class="mt-3 text-muted">Printed on <t t-esc="doc.printed_on_label()"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
