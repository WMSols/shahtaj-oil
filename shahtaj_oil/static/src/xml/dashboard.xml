<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_oil.DashboardViewTemplate" owl="1">

        <style>
            .smooth-accordion {
                display: grid;
                grid-template-rows: 0fr;
                transition: grid-template-rows 0.3s ease-in-out, opacity 0.3s ease-in-out;
                opacity: 0;
            }
            .smooth-accordion.open {
                grid-template-rows: 1fr;
                opacity: 1;
            }
            .smooth-accordion-inner {
                overflow: hidden;
            }
        </style>

        <div class="d-flex w-100 h-100 bg-light position-relative overflow-hidden">

            <div t-if="this.state.isSidebarOpen" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-md-none" style="z-index: 1040;" t-on-click="toggleSidebar"></div>

            <div t-attf-class="bg-white border-end shadow-sm flex-column overflow-y-auto transition-all #{this.state.isSidebarOpen ? 'position-fixed top-0 start-0 d-flex h-100' : 'd-none d-md-flex h-100'}" style="width: 280px; min-width: 280px; z-index: 1050;">

                <div class="p-4 border-bottom text-center bg-white position-relative">
                    <button class="btn btn-sm btn-light position-absolute top-0 end-0 m-2 d-md-none shadow-sm" t-on-click="toggleSidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x">
                            <path d="M18 6 6 18"/>
                            <path d="m6 6 12 12"/>
                        </svg>
                    </button>
                    <img src="/web/binary/company_logo" alt="Shahtaj Oil Logo" style="max-height: 100px; width: 100%; object-fit: contain;" class="mb-2 mt-2 mt-md-0"/>
                    <h6 class="mb-0 fw-bold text-dark mt-2">Distributor Portal</h6>
                </div>

                <div class="list-group list-group-flush p-3 fw-bold flex-grow-1">                
                    <!-- NEW: Dashboard Overview Button -->
                    <div class="mb-2">
                        <button t-on-click="() => this.switchTab('overview')" class="list-group-item list-group-item-action border-0 rounded text-start d-flex align-items-center transition-all w-100" t-att-style="this.state.activeTab === 'overview' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                            <span class="me-3 d-flex align-items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard">
                                    <rect width="7" height="9" x="3" y="3" rx="1"/>
                                    <rect width="7" height="5" x="14" y="3" rx="1"/>
                                    <rect width="7" height="9" x="14" y="12" rx="1"/>
                                    <rect width="7" height="5" x="3" y="16" rx="1"/>
                                </svg>
                            </span>
                            Dashboard Overview
                        </button>
                    </div>
                    <div class="mb-2">
                        
                        <button t-on-click="() => this.toggleMenu('territory', 'areas')" class="list-group-item list-group-item-action border-0 rounded text-start d-flex align-items-center justify-content-between transition-all w-100" t-att-style="this.state.activeTab === 'territory' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                            <div class="d-flex align-items-center">
                                <span class="me-3 d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map">
                                        <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/>
                                        <path d="M15 5.764v15"/>
                                        <path d="M9 3.236v15"/>
                                    </svg>
                                </span>
                                Territory &amp; Routes
                            </div>
                            <span class="d-flex align-items-center transition-all" t-att-style="this.state.expandedMenus.territory ? 'transform: rotate(180deg);' : ''">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>
                        <div t-attf-class="smooth-accordion #{this.state.expandedMenus.territory ? 'open' : ''}">
                            <div class="smooth-accordion-inner">
                                <div class="d-flex flex-column ps-4 mt-1 pe-2 gap-1 border-start ms-3 border-2 border-light mb-1">
                                    <button t-on-click="() => this.switchTab('territory', 'areas')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'territory' and this.state.activeSubTab === 'areas' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Zones</button>
                                    <button t-on-click="() => this.switchTab('territory', 'routes')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'territory' and this.state.activeSubTab === 'routes' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Routes</button>
                                    <button t-on-click="() => this.switchTab('territory', 'shops')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'territory' and this.state.activeSubTab === 'shops' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Shops</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <button t-on-click="() => this.toggleMenu('warehouse', 'inventory')" class="list-group-item list-group-item-action border-0 rounded text-start d-flex align-items-center justify-content-between transition-all w-100" t-att-style="this.state.activeTab === 'warehouse' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                            <div class="d-flex align-items-center">
                                <span class="me-3 d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-warehouse">
                                        <path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z"/>
                                        <path d="M6 18h12"/>
                                        <path d="M6 14h12"/>
                                        <rect width="12" height="12" x="6" y="10"/>
                                    </svg>
                                </span>
                                Warehouse &amp; Stock
                            </div>
                            <span class="d-flex align-items-center transition-all" t-att-style="this.state.expandedMenus.warehouse ? 'transform: rotate(180deg);' : ''">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>
                        <div t-attf-class="smooth-accordion #{this.state.expandedMenus.warehouse ? 'open' : ''}">
                            <div class="smooth-accordion-inner">
                                <div class="d-flex flex-column ps-4 mt-1 pe-2 gap-1 border-start ms-3 border-2 border-light mb-1">
                                    <button t-if="this.hasFinancialAccess" t-on-click="() => this.switchTab('warehouse', 'inventory')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'warehouse' and this.state.activeSubTab === 'inventory' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Product List</button>
                                    <button t-on-click="() => this.switchTab('warehouse', 'management')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'warehouse' and this.state.activeSubTab === 'management' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Stock Overview</button>
                                    <button t-if="this.hasFinancialAccess" t-on-click="() => this.switchTab('warehouse', 'taxes')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'warehouse' and this.state.activeSubTab === 'taxes' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Sales Taxes</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <button t-on-click="() => this.toggleMenu('operations', 'checkins')" class="list-group-item list-group-item-action border-0 rounded text-start d-flex align-items-center justify-content-between transition-all w-100" t-att-style="this.state.activeTab === 'operations' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                            <div class="d-flex align-items-center">
                                <span class="me-3 d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity">
                                        <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.48 12H2"/>
                                    </svg>
                                </span>
                                Operations Tracking
                            </div>
                            <span class="d-flex align-items-center transition-all" t-att-style="this.state.expandedMenus.operations ? 'transform: rotate(180deg);' : ''">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>
                        <div t-attf-class="smooth-accordion #{this.state.expandedMenus.operations ? 'open' : ''}">
                            <div class="smooth-accordion-inner">
                                <div class="d-flex flex-column ps-4 mt-1 pe-2 gap-1 border-start ms-3 border-2 border-light mb-1">
                                    <button t-on-click="() => this.switchTab('operations', 'checkins')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'operations' and this.state.activeSubTab === 'checkins' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Shop Check-ins</button>
                                    <button t-on-click="() => this.switchTab('operations', 'orders')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'operations' and this.state.activeSubTab === 'orders' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Live Orders</button>
                                    <button t-on-click="() => this.switchTab('operations', 'performance')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'operations' and this.state.activeSubTab === 'performance' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Bookers Performance</button>
                                    <button t-on-click="() => this.switchTab('operations', 'deliveries')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'operations' and this.state.activeSubTab === 'deliveries' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Pending Deliveries</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2" t-if="this.hasFinancialAccess">
                        <button t-on-click="() => this.toggleMenu('financials', 'money')" class="list-group-item list-group-item-action border-0 rounded text-start d-flex align-items-center justify-content-between transition-all w-100" t-att-style="this.state.activeTab === 'financials' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                            <div class="d-flex align-items-center">
                                <span class="me-3 d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dollar-sign">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/>
                                        <path d="M12 18V6"/>
                                    </svg>
                                </span>
                                Financials
                            </div>
                            <span class="d-flex align-items-center transition-all" t-att-style="this.state.expandedMenus.financials ? 'transform: rotate(180deg);' : ''">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>
                        <div t-attf-class="smooth-accordion #{this.state.expandedMenus.financials ? 'open' : ''}">
                            <div class="smooth-accordion-inner">
                                <div class="d-flex flex-column ps-4 mt-1 pe-2 gap-1 border-start ms-3 border-2 border-light mb-1">
                                    <button t-on-click="() => this.switchTab('financials', 'money')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'financials' and this.state.activeSubTab === 'money' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Money Overview</button>
                                    <button t-on-click="() => this.switchTab('financials', 'cash')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'financials' and this.state.activeSubTab === 'cash' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Cash Activity</button>
                                    <button t-on-click="() => this.switchTab('financials', 'invoices')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'financials' and ['invoices', 'all_orders', 'orders', 'customer_invoices', 'payments', 'credit_notes', 'balances'].includes(this.state.activeSubTab) ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Invoice Management</button>
                                    <button t-on-click="() => this.switchTab('financials', 'credit')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'financials' and this.state.activeSubTab === 'credit' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Credit Risk Control</button>
                                    <button t-on-click="() => this.switchTab('financials', 'tax_ledger')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'financials' and this.state.activeSubTab === 'tax_ledger' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Tax Ledger</button>
                                    <button t-on-click="() => this.switchTab('financials', 'expenses')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'financials' and this.state.activeSubTab === 'expenses' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Expense Management</button>
                                    <button t-on-click="() => this.switchTab('financials', 'pnl')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'financials' and this.state.activeSubTab === 'pnl' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Profit &amp; Loss</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <button t-on-click="() => this.toggleMenu('schedules', 'schedules')" class="list-group-item list-group-item-action border-0 rounded text-start d-flex align-items-center justify-content-between transition-all w-100" t-att-style="this.state.activeTab === 'schedules' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                            <div class="d-flex align-items-center">
                                <span class="me-3 d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days">
                                        <path d="M8 2v4"/>
                                        <path d="M16 2v4"/>
                                        <rect width="18" height="18" x="3" y="4" rx="2"/>
                                        <path d="M3 10h18"/>
                                        <path d="M8 14h.01"/>
                                        <path d="M12 14h.01"/>
                                        <path d="M16 14h.01"/>
                                        <path d="M8 18h.01"/>
                                        <path d="M12 18h.01"/>
                                        <path d="M16 18h.01"/>
                                    </svg>
                                </span>
                                Schedules &amp; Targets
                            </div>
                            <span class="d-flex align-items-center transition-all" t-att-style="this.state.expandedMenus.schedules ? 'transform: rotate(180deg);' : ''">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>
                        <div t-attf-class="smooth-accordion #{this.state.expandedMenus.schedules ? 'open' : ''}">
                            <div class="smooth-accordion-inner">
                                <div class="d-flex flex-column ps-4 mt-1 pe-2 gap-1 border-start ms-3 border-2 border-light mb-1">
                                    <button t-on-click="() => this.switchTab('schedules', 'schedules')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'schedules' and this.state.activeSubTab === 'schedules' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Weekly Schedules</button>
                                    <button t-on-click="() => this.switchTab('schedules', 'targets')" class="list-group-item list-group-item-action border-0 rounded text-start py-2 px-3 small transition-all" t-att-style="this.state.activeTab === 'schedules' and this.state.activeSubTab === 'targets' ? 'color: #0f172a; background-color: #e2e8f0; font-weight: 700;' : 'color: #6b7280; background-color: transparent;'">Performance Targets</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="my-2"/>
                    <button t-on-click="() => this.switchTab('staff')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-start d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'staff' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="me-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </span>
                        Staff Management
                    </button>

                    <button t-on-click="() => this.switchTab('settings')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-start d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'settings' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="me-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings">
                                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </span>
                        Settings
                    </button>

                </div>
            </div>

            <div class="flex-grow-1 d-flex flex-column h-100" style="min-width: 0;">

                <div class="d-md-none bg-white p-3 border-bottom d-flex justify-content-between align-items-center shadow-sm flex-shrink-0" style="z-index: 1020;">
                    <div class="d-flex align-items-center">
                        <img src="/web/binary/company_logo" alt="Logo" style="height: 32px;" class="me-2 object-fit-contain"/>
                        <h6 class="mb-0 fw-bold text-dark">Portal</h6>
                    </div>
                    <button class="btn btn-light border shadow-sm px-2 py-1" t-on-click="toggleSidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu">
                            <line x1="4" x2="20" y1="12" y2="12"/>
                            <line x1="4" x2="20" y1="6" y2="6"/>
                            <line x1="4" x2="20" y1="18" y2="18"/>
                        </svg>
                    </button>
                </div>

                <div class="flex-grow-1 p-2 p-md-3 overflow-y-auto position-relative" style="min-height: 0; background-color: #f8fafc;">
                    

                    <!-- THE LOGO LOADING OVERLAY -->
                    <t t-if="this.state.isSwitchingTab">

                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center" style="background-color: rgba(248, 250, 252, 0.85); z-index: 1000; backdrop-filter: blur(3px);">

                            <!-- Bouncing Logo -->
                            <div>
                                <!-- Replace the src path with your exact webp image path -->
                                <img src="/shahtaj_oil/static/src/img/logo-img.webp" alt="Loading..." style="height: 142px; width: auto; object-fit: contain;"/>
                            </div>

                            <!-- Animated Shadow -->
                            <!-- <div style="width: 50px; height: 6px; background-color: #000; border-radius: 50%; animation: shadow-pulse 1s infinite ease-in-out; margin-top: 10px; margin-bottom: 20px;"></div> -->

                            <!-- Text & Spinner -->
                            <h5 class="fw-bold text-muted d-flex align-items-center" style="letter-spacing: 0.5px;">
                                <span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span>
                                Loading Workspace...
                            </h5>
                        </div>
                    </t>

                    <!-- MASTER DASHBOARD OVERVIEW -->
                    <div t-if="!this.state.isSwitchingTab and this.state.activeTab === 'overview'" class="h-100 p-2">
                     <div class="alert alert-warning border-0 shadow-sm rounded-3 px-4 py-3 mb-3 d-flex align-items-center" role="alert">
                        <div class="fw-bold fs-5 text-dark">Note: This page is under development</div>
                    </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            
                            <div>
                                <h2 class="fw-bold text-dark mb-0">System Overview</h2>
                                <small class="text-muted">High-level KPIs and statistics across all distributor modules.</small>
                            </div>
                            <button class="btn btn-outline-secondary fw-bold shadow-sm d-inline-flex align-items-center" t-on-click="fetchMasterKPIs" t-att-disabled="this.state.isLoadingKpis" title="Refresh KPIs">
                                <span t-if="this.state.isLoadingKpis" class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <i t-else="" class="fa fa-refresh me-2"></i>
                                Refresh
                            </button>
                        </div>
                        
                        <!-- TERRITORY & RETAIL NETWORK KPIs -->
                        <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Territory &amp; Retail Network</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-primary cursor-pointer" t-on-click="() => this.switchTab('territory', 'areas')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Zones</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.totalZones"/></h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-info cursor-pointer" t-on-click="() => this.switchTab('territory', 'routes')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Active Routes</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.totalRoutes"/></h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-success cursor-pointer" t-on-click="() => this.switchTab('territory', 'shops')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Registered Shops</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.totalShops"/></h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-warning cursor-pointer transition-all hover-shadow" t-on-click="() => this.switchTab('territory', 'shops')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Pending Approvals</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.pendingShops"/></h3>
                                        <span t-if="this.state.kpis.pendingShops > 0" class="badge bg-danger rounded-pill shadow-sm">Needs Review</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- OPERATIONS (TODAY) -->
                        <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Operations — Today</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-primary cursor-pointer" t-on-click="() => this.switchTab('operations', 'checkins')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Today's Check-ins</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.todayCheckins"/></h3>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-success cursor-pointer" t-on-click="() => this.switchTab('operations', 'orders')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Today's Orders</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.todayOrders"/></h3>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-warning cursor-pointer" t-on-click="() => this.switchTab('operations', 'deliveries')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Pending Deliveries</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.pendingDeliveries"/></h3>
                                        <span t-if="this.state.kpis.pendingDeliveries > 0" class="badge bg-warning text-dark rounded-pill shadow-sm">Awaiting</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STAFF -->
                        <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Staff &amp; Order Bookers</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-info cursor-pointer" t-on-click="() => this.switchTab('staff')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Bookers</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.totalBookers"/></h3>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-success cursor-pointer" t-on-click="() => this.switchTab('staff')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Online Now</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.onlineBookers"/></h3>
                                        <span t-if="this.state.kpis.onlineBookers > 0" class="badge bg-success rounded-pill shadow-sm">Live</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- WAREHOUSE -->
                        <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Warehouse &amp; Stock</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-primary cursor-pointer" t-on-click="() => this.switchTab('warehouse', 'management')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Sellable Products</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.totalProducts"/></h3>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-danger cursor-pointer" t-on-click="() => this.switchTab('warehouse', 'management')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Out of Stock</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.outOfStockProducts"/></h3>
                                        <span t-if="this.state.kpis.outOfStockProducts > 0" class="badge bg-danger rounded-pill shadow-sm">Low Stock</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SCHEDULES & TARGETS -->
                        <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Schedules &amp; Targets</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-info cursor-pointer" t-on-click="() => this.switchTab('schedules', 'schedules')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Active Schedules</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.activeSchedules"/></h3>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-warning cursor-pointer" t-on-click="() => this.switchTab('schedules', 'targets')">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Active Targets</div>
                                    <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.activeTargets"/></h3>
                                </div>
                            </div>
                        </div>

                        <!-- FINANCIALS (gated) -->
                        <t t-if="this.hasFinancialAccess">
                            <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Financials</h5>
                            <div class="row g-3 mb-4">
                                <div class="col-md-4 col-lg">
                                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-primary cursor-pointer" t-on-click="() => this.switchTab('financials', 'all_orders')">
                                        <div class="text-muted small fw-bold text-uppercase mb-1">Total Orders</div>
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.totalOrders"/></h3>
                                    </div>
                                </div>
                                <div class="col-md-4 col-lg">
                                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-warning cursor-pointer" t-on-click="() => this.switchTab('financials', 'orders')">
                                        <div class="text-muted small fw-bold text-uppercase mb-1">To Invoice</div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.toInvoice"/></h3>
                                            <span t-if="this.state.kpis.toInvoice > 0" class="badge bg-warning text-dark rounded-pill shadow-sm">Action</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 col-lg">
                                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-danger cursor-pointer" t-on-click="() => this.switchTab('financials', 'customer_invoices')">
                                        <div class="text-muted small fw-bold text-uppercase mb-1">Open Invoices</div>
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.openInvoices"/></h3>
                                    </div>
                                </div>
                                <div class="col-md-4 col-lg">
                                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-secondary cursor-pointer" t-on-click="() => this.switchTab('financials', 'credit_notes')">
                                        <div class="text-muted small fw-bold text-uppercase mb-1">Credit Notes</div>
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.creditNotes"/></h3>
                                    </div>
                                </div>
                                <div class="col-md-4 col-lg">
                                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-success cursor-pointer" t-on-click="() => this.switchTab('territory', 'shops')">
                                        <div class="text-muted small fw-bold text-uppercase mb-1">Approved Shops</div>
                                        <h3 class="fw-bold text-dark mb-0"><t t-esc="this.state.kpis.approvedShops"/></h3>
                                    </div>
                                </div>
                            </div>
                        </t>

                    </div>
                    <div t-if="!this.state.isSwitchingTab and this.state.activeTab === 'territory'" class="h-100">
                        <TerritoryRoutes requestedSubTab="this.state.activeSubTab" />
                    </div>

                    <div t-if="!this.state.isSwitchingTab and this.state.activeTab === 'warehouse'" class="h-100">
                        <WarehouseInventory requestedSubTab="this.state.activeSubTab" />
                    </div>

                    <div t-if="!this.state.isSwitchingTab and this.state.activeTab === 'operations'" class="h-100">
                        <OperationsTracking requestedSubTab="this.state.activeSubTab" />
                    </div>

                    <div t-if="!this.state.isSwitchingTab and this.hasFinancialAccess and this.state.activeTab === 'financials'" class="h-100">
                        <FinancialsInvoicing requestedSubTab="this.state.activeSubTab" />
                    </div>

                    <div t-if="!this.state.isSwitchingTab and this.state.activeTab === 'staff'" class="h-100">
                        <StaffManagement />
                    </div>

                    <div t-if="!this.state.isSwitchingTab and this.state.activeTab === 'schedules'" class="h-100">
                        <SchedulesTargets requestedSubTab="this.state.activeSubTab" />
                    </div>

                    <div t-if="!this.state.isSwitchingTab and this.hasFinancialAccess and this.state.activeTab === 'transactions'" class="h-100">
                        <BankTransactions />
                    </div>

                    <div t-if="!this.state.isSwitchingTab and this.state.activeTab === 'settings'" class="h-100">
                        <PortalSettings />
                    </div>

                </div>
            </div>
        </div>
    </t>
</templates>
