<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_oil.BankTransactions" owl="1">
        <div class="card border-0 shadow-sm p-4 rounded-3">
            
            <t t-if="this.state.viewMode === 'list'">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h4 class="fw-bold">Bank Transactions</h4>
                    <p class="text-warning fw-bold mb-0">(NOTE :This UI is based on mock data for demonstration purposes)</p>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="Search Payee..." t-model="this.state.searchQuery"/>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" t-model="this.state.filterBank">
                            <option value="all">All Banks</option>
                            <option value="HBL">HBL</option>
                            <option value="Meezan">Meezan</option>
                            <option value="Alfalah">Alfalah</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" t-model="this.state.sortBy">
                            <option value="date_desc">Newest First</option>
                            <option value="amount_asc">Amount: Low to High</option>
                            <option value="amount_desc">Amount: High to Low</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" class="form-control" t-model="this.state.dateFrom" title="From Date"/>
                    </div>
                    <div class="col-md-2">
                        <input type="date" class="form-control" t-model="this.state.dateTo" title="To Date"/>
                    </div>
                </div>

                <table class="table table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>Date</th><th>Bank</th><th>Payee</th><th>Amount</th><th>Status</th><th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="this.filteredTransactions" t-as="t" t-key="t.id">
                            <tr t-on-click="() => this.viewDetails(t)" style="cursor: pointer;">
                                <td><t t-esc="t.date"/></td>
                                <td><span class="badge bg-light text-dark border"><t t-esc="t.bank"/></span></td>
                                <td><t t-esc="t.payee"/></td>
                                <td class="fw-bold">Rs. <t t-esc="t.amount"/></td>
                                <td><span t-attf-class="badge #{t.status === 'Completed' ? 'bg-success' : 'bg-warning'}"><t t-esc="t.status"/></span></td>
                                <td><button class="btn btn-sm btn-outline-primary">View</button></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <t t-if="this.state.viewMode === 'detail'">
                <button class="btn btn-sm btn-secondary mb-3" t-on-click="goBack">← Back to List</button>
                <div class="card p-4 bg-light">
                    <h5>Transaction Details: <t t-esc="this.state.selectedTransaction.payee"/></h5>
                    <hr/>
                    <p><strong>Date:</strong> <t t-esc="this.state.selectedTransaction.date"/></p>
                    <p><strong>Bank:</strong> <t t-esc="this.state.selectedTransaction.bank"/></p>
                    <p><strong>Amount:</strong> Rs. <t t-esc="this.state.selectedTransaction.amount"/></p>
                    <p><strong>Status:</strong> <t t-esc="this.state.selectedTransaction.status"/></p>
                    <p><strong>Description:</strong> <t t-esc="this.state.selectedTransaction.details"/></p>
                </div>
            </t>
        </div>
    </t>
</templates>